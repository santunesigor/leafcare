{
  "seed": 42,
  "dataset_dir": "data/raw",
  "prepared_dir": "data/prepared",
  "output_dir": "artifacts",
  "catalog_file": "disease_catalog.json",
  "groups_csv": "data/groups.csv",
  "image_size": 224,
  "max_image_pixels": 16000000,
  "split": {
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "near_duplicate_hamming": 4,
  "minimum_groups_per_class": 8,
  "batch_size": 16,
  "epochs_frozen": 25,
  "epochs_finetune": 20,
  "fine_tune_last_layers": 30,
  "learning_rate_frozen": 0.001,
  "learning_rate_finetune": 1e-05,
  "early_stopping_patience": 6,
  "class_weight_ratio_threshold": 1.5,
  "confidence_threshold": 0.7,
  "export": {
    "parity_max_abs_error": 0.0001,
    "parity_images": 20,
    "android_assets_dir": "../android-app/app/src/main/assets"
  }
}
